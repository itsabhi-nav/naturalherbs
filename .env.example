# ==================================================================
#  NaturalHerbs, environment reference (SAFE to commit to GitHub)
# ==================================================================
# Yeh file sirf YAAD-DILANE ke liye hai: production/Vercel configure
# karte waqt ise dekho. Asli secrets kabhi commit mat karo .
# .env file sirf local pe rakho (git-ignored hai).
#
# NOTE: Yeh site ZERO-BACKEND hai, yani abhi koi bhi variable
# required nahi hai. Site chalne ke liye khali .env bhi kaafi hai.
# Neeche wale variables future/provisioning ke liye hain.
# ------------------------------------------------------------------

# ---- SITE URL (SEO metadata ka base; deployment ka real domain) ----
NEXT_PUBLIC_SITE_URL=https://natural-herbs.in

# ---- FUTURE FORM BACKEND (agar mailto ki jagah server form chahiye) ----
# Resend / ConvertKit / Formspree, kuch bhi:
# RESEND_API_KEY=re_xxxxxxxxxxxxxxxx
# FORMSPREE_ID=xxxxxxxx

# ---- ANALYTICS (optional, tracking procura) ----
# NEXT_PUBLIC_GA_ID=G-XXXXXXXXXX
# NEXT_PUBLIC_UMAMI_ID=

# ---- SEARCH ENGINE VERIFICATION (Google / Bing webmaster tools) ----
# GOOGLE_SITE_VERIFICATION=xxxxxxxxxxxxxxxx
# BING_SITE_VERIFICATION=xxxxxxxxxxxx

# ---- EMAILS / CONTACT (hardcoded bhi hain lib/data.ts me) ----
# CONTACT_EMAIL=naturalherbs555@gmail.com
# CONTACT_PHONE_INDIA=+918285330983
# CONTACT_PHONE_CANADA=+14375777874
